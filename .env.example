BREVO_API_KEY=

# Issuer authentication and encrypted retention.
PUBLIC_BASE_URL=https://your-domain.example

# Stripe Checkout. Webhook endpoint: https://your-domain.example/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional price overrides in USD cents: PLAN_PRICE_1_DAY_CENTS, PLAN_PRICE_1_WEEK_CENTS, PLAN_PRICE_1_MONTH_CENTS, PLAN_PRICE_1_YEAR_CENTS
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
ISSUER_REVIEW_TOKEN=

# Gumroad license verification and product mapping.
GUMROAD_API_KEY=
GUMROAD_SINGLE_USE_PRODUCT_ID=
GUMROAD_MONTHLY_PRODUCT_ID=
GUMROAD_YEARLY_PRODUCT_ID=
POSTHOG_API_KEY=

# Foundation account OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Signed Apple client-secret JWT for APPLE_CLIENT_ID.
APPLE_CLIENT_SECRET=

# On Linode, use a persistent directory for SQLite and encrypted issuer ledgers.
DATA_DIR=/var/lib/usevs
PORT=8080
