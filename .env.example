SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=verification@example.com

# Issuer authentication and encrypted retention.
PUBLIC_BASE_URL=https://usevs.onrender.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
ISSUER_REVIEW_TOKEN=

# Required in production: mount a private durable volume and set DATA_DIR to its path.
DATA_DIR=/data

# PayFast: use sandbox credentials until the integration is verified.
PAYFAST_MODE=sandbox
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=https://your-public-domain.example/payfast/return
PAYFAST_CANCEL_URL=https://your-public-domain.example/payfast/cancel
PAYFAST_NOTIFY_URL=https://your-public-domain.example/payfast/notify
PAYFAST_ONCE_OFF_AMOUNT=4.99
PAYFAST_SUBSCRIPTION_AMOUNT=24.99
PAYFAST_SUBSCRIPTION_FREQUENCY=3
PAYFAST_SUBSCRIPTION_CYCLES=0