SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=verification@example.com

# Issuer authentication and encrypted retention.
PUBLIC_BASE_URL=https://usevs.railway.app
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
ISSUER_REVIEW_TOKEN=

# In Railway, mount a persistent volume at /var/data/usevs for SQLite and encrypted issuer ledgers.
DATA_DIR=/var/data/usevs
# Railway provides PORT at runtime.
